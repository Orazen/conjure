# --- Pick ONE backend -------------------------------------------------------
# 1) Comfy Cloud (easiest). Create a key at https://platform.comfy.org/profile/api-keys
COMFY_API_KEY=
# 2) A Comfy API deployment or a self-hosted ComfyUI behind comfy-api-proxy:
# COMFY_BASE_URL=http://127.0.0.1:8189
# 3) No GPU at all? Mock mode renders a fake preview so you can try the app:
# CONJURE_MOCK=1

# --- Optional ---------------------------------------------------------------
# PORT=8787
# HOST=127.0.0.1
# Repo that "Submit effect" opens a GitHub pull request against:
# CONJURE_GITHUB_REPO=your-name/conjure
