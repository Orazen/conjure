{
  "flux_model": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux3_image_klein_sd_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "FLUX 3 Image Klein (distilled, int8)"
    }
  },
  "flux_text_encoder": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_4b_int8_convrot.safetensors",
      "type": "flux3",
      "device": "default"
    },
    "_meta": {
      "title": "FLUX 3 text encoder (Qwen3-VL 4B)"
    }
  },
  "flux_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    },
    "_meta": {
      "title": "FLUX VAE"
    }
  },
  "prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "flux_text_encoder",
        0
      ]
    },
    "_meta": {
      "title": "Conjure: sample prompt"
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "flux_text_encoder",
        0
      ]
    },
    "_meta": {
      "title": "Empty negative"
    }
  },
  "latent": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": 768,
      "height": 1344,
      "batch_size": 1
    },
    "_meta": {
      "title": "Latent"
    }
  },
  "sample": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 16,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": [
        "flux_model",
        0
      ],
      "positive": [
        "prompt",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "latent_image": [
        "latent",
        0
      ]
    },
    "_meta": {
      "title": "Conjure: seed"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "flux_vae",
        0
      ]
    },
    "_meta": {
      "title": "Decode"
    }
  },
  "save_image": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "conjure/sample",
      "images": [
        "decode",
        0
      ]
    },
    "_meta": {
      "title": "Conjure: save sample"
    }
  }
}
