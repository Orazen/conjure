{
  "load_image": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "conjure_input.png"
    },
    "_meta": {
      "title": "Conjure: input photo"
    }
  },
  "resize_image": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "resize_type": "scale dimensions",
      "resize_type.width": 704,
      "resize_type.height": 1280,
      "resize_type.crop": "center",
      "scale_method": "lanczos",
      "input": [
        "load_image",
        0
      ]
    },
    "_meta": {
      "title": "Fit photo to output size"
    }
  },
  "flux_model": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux3_image_klein_sd_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "FLUX 3 Image Klein (distilled, int8)"
    }
  },
  "flux_text_encoder": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_4b_int8_convrot.safetensors",
      "type": "flux3",
      "device": "default"
    },
    "_meta": {
      "title": "FLUX 3 text encoder (Qwen3-VL 4B)"
    }
  },
  "flux_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    },
    "_meta": {
      "title": "FLUX VAE"
    }
  },
  "edit_prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "flux_text_encoder",
        0
      ]
    },
    "_meta": {
      "title": "Conjure: end-frame instruction"
    }
  },
  "edit_negative": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "edit_prompt",
        0
      ]
    },
    "_meta": {
      "title": "Empty negative"
    }
  },
  "edit_reference": {
    "class_type": "ReferenceMultiLatent",
    "inputs": {
      "resolution": "resize",
      "resolution.megapixels": 1,
      "positive": [
        "edit_prompt",
        0
      ],
      "negative": [
        "edit_negative",
        0
      ],
      "vae": [
        "flux_vae",
        0
      ],
      "images.image0": [
        "resize_image",
        0
      ]
    },
    "_meta": {
      "title": "Photo as edit reference"
    }
  },
  "edit_seed": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 16,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": [
        "flux_model",
        0
      ],
      "positive": [
        "edit_reference",
        0
      ],
      "negative": [
        "edit_reference",
        1
      ],
      "latent_image": [
        "edit_reference",
        2
      ]
    },
    "_meta": {
      "title": "Conjure: end-frame sampler"
    }
  },
  "edit_decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "edit_seed",
        0
      ],
      "vae": [
        "flux_vae",
        0
      ]
    },
    "_meta": {
      "title": "Decode end frame"
    }
  },
  "save_end_frame": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "conjure/end_frame",
      "images": [
        "edit_decode",
        0
      ]
    },
    "_meta": {
      "title": "Conjure: save end frame"
    }
  },
  "resize_end_frame": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "resize_type": "scale dimensions",
      "resize_type.width": 704,
      "resize_type.height": 1280,
      "resize_type.crop": "center",
      "scale_method": "lanczos",
      "input": [
        "edit_decode",
        0
      ]
    },
    "_meta": {
      "title": "Fit end frame to output size"
    }
  },
  "ltx_model": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "LTX-2.5 22B distilled (int8)"
    }
  },
  "ltx_text_encoder": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "type": "ltxv",
      "device": "default"
    },
    "_meta": {
      "title": "LTX-2.5 text encoder (Gemma 4)"
    }
  },
  "ltx_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
    },
    "_meta": {
      "title": "LTX-2.5 video VAE"
    }
  },
  "ltx_audio_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
    },
    "_meta": {
      "title": "LTX-2.5 audio VAE"
    }
  },
  "prompt": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "Use the provided start image as the first frame and the provided end image as the final frame anchor.",
      "clip": [
        "ltx_text_encoder",
        0
      ]
    },
    "_meta": {
      "title": "Conjure: motion prompt"
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, out of focus, overexposed, underexposed, low contrast, washed out colors, excessive noise, grainy texture, flickering, distorted proportions, deformed facial features, extra limbs, watermark, text, subtitles, pc game, console game, video game, cartoon, childish, ugly",
      "clip": [
        "ltx_text_encoder",
        0
      ]
    },
    "_meta": {
      "title": "Conjure: negative prompt"
    }
  },
  "conditioning": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "frame_rate": 24.0,
      "positive": [
        "prompt",
        0
      ],
      "negative": [
        "negative",
        0
      ]
    },
    "_meta": {
      "title": "LTXV conditioning (fps)"
    }
  },
  "preprocess_start": {
    "class_type": "LTXVPreprocess",
    "inputs": {
      "img_compression": 18,
      "image": [
        "resize_image",
        0
      ]
    },
    "_meta": {
      "title": "LTXV preprocess (start)"
    }
  },
  "preprocess_end": {
    "class_type": "LTXVPreprocess",
    "inputs": {
      "img_compression": 18,
      "image": [
        "resize_end_frame",
        0
      ]
    },
    "_meta": {
      "title": "LTXV preprocess (end)"
    }
  },
  "empty_video": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": 704,
      "height": 1280,
      "length": 121,
      "batch_size": 1
    },
    "_meta": {
      "title": "Video latent"
    }
  },
  "guide_start": {
    "class_type": "LTXVAddGuide",
    "inputs": {
      "frame_idx": 0,
      "strength": 1.0,
      "positive": [
        "conditioning",
        0
      ],
      "negative": [
        "conditioning",
        1
      ],
      "vae": [
        "ltx_vae",
        0
      ],
      "latent": [
        "empty_video",
        0
      ],
      "image": [
        "preprocess_start",
        0
      ]
    },
    "_meta": {
      "title": "Conjure: start frame guide"
    }
  },
  "guide_end": {
    "class_type": "LTXVAddGuide",
    "inputs": {
      "frame_idx": -1,
      "strength": 0.8,
      "positive": [
        "guide_start",
        0
      ],
      "negative": [
        "guide_start",
        1
      ],
      "vae": [
        "ltx_vae",
        0
      ],
      "latent": [
        "guide_start",
        2
      ],
      "image": [
        "preprocess_end",
        0
      ]
    },
    "_meta": {
      "title": "Conjure: end frame guide"
    }
  },
  "empty_audio": {
    "class_type": "LTXVEmptyLatentAudio",
    "inputs": {
      "frames_number": 121,
      "frame_rate": 24,
      "batch_size": 1,
      "audio_vae": [
        "ltx_audio_vae",
        0
      ]
    },
    "_meta": {
      "title": "Audio latent"
    }
  },
  "av_latent": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": [
        "guide_end",
        2
      ],
      "audio_latent": [
        "empty_audio",
        0
      ]
    },
    "_meta": {
      "title": "AV latent"
    }
  },
  "noise_1": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 42
    },
    "_meta": {
      "title": "Conjure: seed"
    }
  },
  "guider": {
    "class_type": "LTXVDualCFGGuider",
    "inputs": {
      "video_cfg": 1,
      "audio_cfg": 1,
      "model": [
        "ltx_model",
        0
      ],
      "positive": [
        "guide_end",
        0
      ],
      "negative": [
        "guide_end",
        1
      ]
    },
    "_meta": {
      "title": "Guider"
    }
  },
  "sampler": {
    "class_type": "SamplerEulerAncestral",
    "inputs": {
      "eta": 0,
      "s_noise": 1
    },
    "_meta": {
      "title": "Sampler"
    }
  },
  "sigmas": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
    },
    "_meta": {
      "title": "Sigmas (8 steps)"
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise_1",
        0
      ],
      "guider": [
        "guider",
        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "sigmas",
        0
      ],
      "latent_image": [
        "av_latent",
        0
      ]
    },
    "_meta": {
      "title": "Sample"
    }
  },
  "split": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": [
        "sample",
        1
      ]
    },
    "_meta": {
      "title": "Split AV"
    }
  },
  "crop_guides": {
    "class_type": "LTXVCropGuides",
    "inputs": {
      "positive": [
        "guide_end",
        0
      ],
      "negative": [
        "guide_end",
        1
      ],
      "latent": [
        "split",
        0
      ]
    },
    "_meta": {
      "title": "Drop guide frames"
    }
  },
  "decode_video": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 16,
      "samples": [
        "crop_guides",
        2
      ],
      "vae": [
        "ltx_vae",
        0
      ]
    },
    "_meta": {
      "title": "Decode video"
    }
  },
  "decode_audio": {
    "class_type": "LTXVAudioVAEDecode",
    "inputs": {
      "samples": [
        "split",
        1
      ],
      "audio_vae": [
        "ltx_audio_vae",
        0
      ]
    },
    "_meta": {
      "title": "Decode audio"
    }
  },
  "create_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "fps": 24.0,
      "bit_depth": 8,
      "color_space": "sRGB",
      "codec": "none",
      "images": [
        "decode_video",
        0
      ],
      "audio": [
        "decode_audio",
        0
      ]
    },
    "_meta": {
      "title": "Create video"
    }
  },
  "save_video": {
    "class_type": "SaveVideo",
    "inputs": {
      "filename_prefix": "conjure/transform",
      "format": "auto",
      "format.codec": "auto",
      "video": [
        "create_video",
        0
      ]
    },
    "_meta": {
      "title": "Conjure: save video"
    }
  }
}
